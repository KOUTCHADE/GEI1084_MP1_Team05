library IEEE;
use IEEE.STD_LOGIC_1164.ALL;
use IEEE.NUMERIC_STD.ALL;
-- Uncomment the following library declaration if using
-- arithmetic functions with Signed or Unsigned values
--use IEEE.NUMERIC_STD.ALL;

-- Uncomment the following library declaration if instantiating
-- any Xilinx leaf cells in this code.
--library UNISIM;
--use UNISIM.VComponents.all;

entity shifter is
Port ( 

        RD2        : in  STD_LOGIC_VECTOR(31 downto 0);
        shamt      : in  STD_LOGIC_VECTOR(4 downto 0);
        ShiftType  : in  STD_LOGIC_VECTOR(1 downto 0);
        ShiftedRD2 : out STD_LOGIC_VECTOR(31 downto 0)


  );
end shifter;

architecture Behavioral of shifter is

begin

 process(RD2, shamt, ShiftType)

begin

        case ShiftType is

            -- LSL : decalage logique a gauche
            when "00" =>
                ShiftedRD2 <= std_logic_vector(
                    shift_left(unsigned(RD2),
                    to_integer(unsigned(shamt)))
                );

            -- LSR : decalage logique a droite
            when "01" =>
                ShiftedRD2 <= std_logic_vector(
                    shift_right(unsigned(RD2),
                    to_integer(unsigned(shamt)))
                );

            -- Operations non supportees
            when others =>
                ShiftedRD2 <= RD2;

        end case;

    end process;


end Behavioral;

